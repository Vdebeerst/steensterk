<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <!-- Default Tags -->
    <record id="sh_invoice_tags_id_res_config_settings_view_crm_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.sale.form.inherit</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//app[@name='account']//block[@name='fiscal_localization_setting_container']" position="after">
                <block title="Default Tags Configuration" name="setting_invoice_tags">
                    <setting id="invoice_tags_options">
                        <field name="invoice_tags_id" widget="many2many_tags" options="{'color_field': 'color'}"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
