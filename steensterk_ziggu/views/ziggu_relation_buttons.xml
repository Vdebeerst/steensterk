<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="ziggu_project_project_relation_buttons" model="ir.ui.view">
            <field name="name">project.project.ziggu.relation.buttons</field>
            <field name="model">project.project</field>
            <field name="inherit_id" ref="project.edit_project"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button name="action_ziggu_buildings" type="object" class="oe_stat_button" icon="fa-building">
                        <field name="ziggu_building_ids" widget="statinfo" string="Buildings"/>
                    </button>
                    <!-- <button name="action_ziggu_lots" type="object" class="oe_stat_button" icon="fa-map">
                        <field name="ziggu_lot_ids" widget="statinfo" string="Lots"/>
                    </button> -->
                    <button name="action_ziggu_units" type="object" class="oe_stat_button" icon="fa-home">
                        <field name="ziggu_unit_ids" widget="statinfo" string="Units"/>
                    </button>
                    <button name="action_ziggu_decisions" type="object" class="oe_stat_button" icon="fa-check-square-o">
                        <field name="ziggu_decision_ids" widget="statinfo" string="Decisions"/>
                    </button>
                    <button name="action_ziggu_issues" type="object" class="oe_stat_button" icon="fa-exclamation-circle">
                        <span class="o_stat_text">Issues</span>
                    </button>
                    <button name="action_ziggu_tickets" type="object" class="oe_stat_button" icon="fa-ticket">
                        <span class="o_stat_text">Tickets</span>
                    </button>
                    <button name="action_ziggu_documents" type="object" class="oe_stat_button" icon="fa-paperclip">
                        <field name="ziggu_attachment_ids" widget="statinfo" string="Documents"/>
                    </button>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
