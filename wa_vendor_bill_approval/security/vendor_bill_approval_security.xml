<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_vendor_bill_approver" model="res.groups">
        <field name="name">Vendor Bill Approver</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <function model="vendor.bill.approval.level" name="_sync_approver_group"/>

    <record id="vendor_bill_approval_level_company_rule" model="ir.rule">
        <field name="name">Vendor bill approval levels by company</field>
        <field name="model_id" ref="model_vendor_bill_approval_level"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="vendor_bill_approval_line_company_rule" model="ir.rule">
        <field name="name">Vendor bill approvals by company</field>
        <field name="model_id" ref="model_vendor_bill_approval_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="vendor_bill_approval_line_approver_rule" model="ir.rule">
        <field name="name">Own vendor bill approvals</field>
        <field name="model_id" ref="model_vendor_bill_approval_line"/>
        <field name="groups" eval="[(4, ref('group_vendor_bill_approver'))]"/>
        <field name="domain_force">['|', ('approver_ids', 'in', [user.id]), ('approved_by_id', '=', user.id)]</field>
    </record>

    <record id="vendor_bill_approval_line_account_user_rule" model="ir.rule">
        <field name="name">All vendor bill approvals for accountants</field>
        <field name="model_id" ref="model_vendor_bill_approval_line"/>
        <field name="groups" eval="[(4, ref('account.group_account_user'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
</odoo>