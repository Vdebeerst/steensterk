<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_wa_analytic_distribution_wizard_form" model="ir.ui.view">
        <field name="name">wa.account.analytic.distribution.wizard.form</field>
        <field name="model">wa.account.analytic.distribution.wizard</field>
        <field name="arch" type="xml">
            <form string="Update Journal Item Analytic Distributions">
                <group>
                    <field name="account_id"/>
                    <field name="company_id"/>
                    <field name="scope"/>
                    <field name="update_method"/>
                    <field name="line_count" readonly="1"/>
                </group>
                <div class="alert alert-warning" role="alert">This operation can modify analytic distributions on posted journal items. Confirm before proceeding.</div>
                <footer>
                    <button name="action_confirm" type="object" string="Confirm Update" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
