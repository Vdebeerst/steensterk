<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_api" model="ir.module.category">
        <field name="name">API Management</field>
        <field name="sequence">100</field>
    </record>

    <record id="privilege_api" model="res.groups.privilege">
        <field name="name">API Access</field>
        <field name="category_id" ref="module_category_api"/>
        <field name="sequence">10</field>
    </record>

    <record id="group_api_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="privilege_api"/>
    </record>

    <record id="group_api_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="privilege_api"/>
        <field name="implied_ids" eval="[(4, ref('group_api_user'))]"/>
    </record>
</odoo>
