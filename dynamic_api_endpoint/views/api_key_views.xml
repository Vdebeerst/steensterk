<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="api_key_tree" model="ir.ui.view">
        <field name="name">api.key.tree</field>
        <field name="model">api.key</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="key" password="True"/>
                <field name="user_id"/>
                <field name="rate_limit"/>
                <field name="call_count"/>
                <field name="last_used"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="api_key_form" model="ir.ui.view">
        <field name="name">api.key.form</field>
        <field name="model">api.key</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="API Key Name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="key" widget="CopyClipboardChar"/>
                            <button name="action_regenerate_key" string="Regenerate Key"
                                    type="object" class="btn-warning"/>
                            <field name="user_id"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="rate_limit"/>
                            <field name="call_count"/>
                            <field name="last_used"/>
                        </group>
                    </group>
                    <group string="Allowed Endpoints">
                        <field name="endpoint_ids" widget="many2many_tags" nolabel="1"/>
                        <p class="text-muted">Leave empty to allow access to all endpoints</p>
                    </group>
                </sheet>
                <chatter/>

            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_api_key" model="ir.actions.act_window">
        <field name="name">API Keys</field>
        <field name="res_model">api.key</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first API key
            </p>
            <p>
                API keys authenticate external systems accessing your API endpoints.
            </p>
        </field>
    </record>
</odoo>
