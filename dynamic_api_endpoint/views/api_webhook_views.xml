<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="api_webhook_tree" model="ir.ui.view">
        <field name="name">api.webhook.tree</field>
        <field name="model">api.webhook</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="model_name"/>
                <field name="target_url"/>
                <field name="on_create" widget="boolean_toggle"/>
                <field name="on_write" widget="boolean_toggle"/>
                <field name="on_unlink" widget="boolean_toggle"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'active'"
                       decoration-warning="state == 'draft'"
                       decoration-danger="state == 'disabled'"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="api_webhook_form" model="ir.ui.view">
        <field name="name">api.webhook.form</field>
        <field name="model">api.webhook</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_activate" string="Activate"
                            type="object" class="btn-primary"
                            invisible="state == 'active'"/>
                    <button name="action_disable" string="Disable"
                            type="object"
                            invisible="state != 'active'"/>
                    <button name="action_draft" string="Reset to Draft"
                            type="object"
                            invisible="state == 'draft'"/>
                    <button name="action_test_webhook" string="Test Webhook"
                            type="object" class="btn-warning"
                            invisible="state != 'active'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,active"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Webhook Name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="model_id" options="{'no_create': True}"/>
                            <field name="model_name" invisible="1"/>
                            <field name="target_url" placeholder="https://example.com/webhook"/>
                            <field name="secret" password="True"/>
                        </group>
                        <group>
                            <field name="on_create"/>
                            <field name="on_write"/>
                            <field name="on_unlink"/>
                            <field name="domain"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Payload Fields" name="fields">
                            <field name="field_ids" widget="many2many_tags"
                                   domain="[('model_id', '=', model_id)]"
                                   options="{'no_create': True}"/>
                            <p class="text-muted">Leave empty to send default fields (id, name, display_name, create_date, write_date)</p>
                        </page>
                        <page string="Custom Headers" name="headers">
                            <field name="header_ids">
                                <list editable="bottom">
                                    <field name="name" placeholder="X-Custom-Header"/>
                                    <field name="value" placeholder="header-value"/>
                                </list>
                            </field>
                        </page>
                        <page string="Logs" name="logs">
                            <field name="log_ids" readonly="1">
                                <list>
                                    <field name="create_date"/>
                                    <field name="method"/>
                                    <field name="path"/>
                                    <field name="response_code"/>
                                    <field name="status" widget="badge"
                                           decoration-success="status == 'success'"
                                           decoration-danger="status == 'error'"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>

            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_api_webhook" model="ir.actions.act_window">
        <field name="name">Webhooks</field>
        <field name="res_model">api.webhook</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first webhook
            </p>
            <p>
                Webhooks notify external systems when records are created, updated, or deleted.
            </p>
        </field>
    </record>
</odoo>
