<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="steensterk_sale_order_form" model="ir.ui.view">
            <field name="name">steensterk.sale.order.form</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <field name="partner_shipping_id" position="after">
                    <field name="partner_prive_id" options="{'no_quick_create': True}" readonly="state == 'cancel' or locked"/>
                </field>
            </field>
        </record>
        
    </data>
</odoo>
