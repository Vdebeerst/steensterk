<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="vendor_bill_approval_line_view_list" model="ir.ui.view">
        <field name="name">vendor.bill.approval.line.list</field>
        <field name="model">vendor.bill.approval.line</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" decoration-info="state == 'pending'" decoration-success="state == 'approved'">
                <field name="partner_id"/>
                <field name="reference"/>
                <field name="invoice_number"/>
                <field name="invoice_date"/>
                <field name="invoice_date_due"/>
                <field name="amount_total" sum="Total"/>
                <field name="currency_id" optional="hide"/>
                <field name="name" string="Approval Level"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="vendor_bill_approval_line_view_form" model="ir.ui.view">
        <field name="name">vendor.bill.approval.line.form</field>
        <field name="model">vendor.bill.approval.line</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0" string="Vendor Bill Approval">
                <header>
                    <button name="action_approve" type="object" string="Approve" class="oe_highlight" invisible="not can_approve or has_optional_next_approval"/>
                    <button name="action_approve_without_extra" type="object" string="Approve without Extra Approval" class="oe_highlight" invisible="not can_approve or not has_optional_next_approval"/>
                    <button name="action_approve_with_extra" type="object" string="Approve and Request Extra Approval" invisible="not can_approve or not has_optional_next_approval"/>
                    <button name="action_open_reject_wizard" type="object" string="Reject" invisible="not can_approve"/>
                    <button name="action_undo" type="object" string="Undo Approval" confirm="The most recent approval will be undone. Do you want to continue?" invisible="not can_undo"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,approved,rejected"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_attachment" type="object" class="oe_stat_button" icon="fa-file-pdf-o" invisible="not has_attachment">
                            <div class="o_stat_info"><span class="o_stat_text">Invoice document</span></div>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Pending" bg_color="text-bg-info" invisible="state != 'pending'"/>
                    <h1><field name="partner_id" readonly="1" options="{'no_open': True}"/></h1>
                    <group>
                        <group>
                            <field name="reference"/>
                            <field name="invoice_number"/>
                            <field name="invoice_date"/>
                            <field name="invoice_date_due"/>
                        </group>
                        <group>
                            <field name="amount_total"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="name" string="Approval Level"/>
                            <field name="approver_ids" widget="many2many_tags" options="{'no_open': True}"/>
                        </group>
                    </group>
                    <field name="can_approve" invisible="1"/>
                    <field name="can_undo" invisible="1"/>
                    <field name="has_optional_next_approval" invisible="1"/>
                    <field name="has_attachment" invisible="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="vendor_bill_approval_line_view_search" model="ir.ui.view">
        <field name="name">vendor.bill.approval.line.search</field>
        <field name="model">vendor.bill.approval.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <field name="reference"/>
                <filter name="pending" string="To Review" domain="[('state', '=', 'pending')]"/>
                <filter name="approved" string="Approved" domain="[('state', '=', 'approved')]"/>
                <group>
                    <filter name="group_partner" string="Vendor" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_level" string="Approval Level" context="{'group_by': 'name'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_vendor_bill_approval_inbox" model="ir.actions.act_window">
        <field name="name">Vendor Bills</field>
        <field name="res_model">vendor.bill.approval.line</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="vendor_bill_approval_line_view_search"/>
        <field name="domain">[('state', '=', 'pending'), ('approver_ids', 'in', [uid])]</field>
        <field name="context">{'search_default_pending': 1}</field>
    </record>
</odoo>
