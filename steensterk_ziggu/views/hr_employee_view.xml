<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="ziggu_hr_employee_form" model="ir.ui.view">
            <field name="name">ziggu.hr.employee.form</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_form"/>
            <field name="arch" type="xml">
                <notebook position="inside">
                    <page string="Ziggu" name="ziggu">
                        <group colspan="4" col="2">
                            <group>
                                <field name="ziggu_id"/>
                                <field name="ziggu_type"/>
                                <field name="ziggu_first_name"/>
                                <field name="ziggu_last_name"/>
                            </group>
                            <group>
                                <field name="ziggu_email"/>
                                <field name="ziggu_mobile"/>
                                <field name="ziggu_phone"/>
                                <field name="ziggu_created_at"/>
                                <field name="ziggu_updated_at"/>
                            </group>
                        </group>
                    </page>
                </notebook>
            </field>
        </record>
    </data>
</odoo>
