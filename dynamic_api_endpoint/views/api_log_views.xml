<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="api_log_tree" model="ir.ui.view">
        <field name="name">api.log.tree</field>
        <field name="model">api.log</field>
        <field name="arch" type="xml">
            <list>
                <field name="create_date"/>
                <field name="method"/>
                <field name="path"/>
                <field name="endpoint_id"/>
                <field name="webhook_id"/>
                <field name="response_code"/>
                <field name="duration_ms" widget="float"/>
                <field name="api_key_id"/>
                <field name="ip_address"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'success'"
                       decoration-danger="status == 'error'"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="api_log_form" model="ir.ui.view">
        <field name="name">api.log.form</field>
        <field name="model">api.log</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="method"/>
                            <field name="path"/>
                            <field name="response_code"/>
                            <field name="duration_ms"/>
                            <field name="status"/>
                        </group>
                        <group>
                            <field name="endpoint_id"/>
                            <field name="webhook_id"/>
                            <field name="api_key_id"/>
                            <field name="ip_address"/>
                            <field name="create_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Request">
                            <field name="request_body"/>
                        </page>
                        <page string="Response">
                            <field name="response_body"/>
                        </page>
                    </notebook>
                </sheet>
            <chatter/>

            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_api_log" model="ir.actions.act_window">
        <field name="name">API Logs</field>
        <field name="res_model">api.log</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
