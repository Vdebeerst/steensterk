<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cash_planning_account_line_list" model="ir.ui.view">
        <field name="name">cash.planning.account.line.list</field>
        <field name="model">cash.planning.account.line</field>
        <field name="arch" type="xml">
            <list>
                <field name="company_id"/>
                <field name="flow_type_id"/>
                <field name="direction"/>
                <field name="account_id"/>
                <field name="note"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="view_cash_planning_account_line_form" model="ir.ui.view">
        <field name="name">cash.planning.account.line.form</field>
        <field name="model">cash.planning.account.line</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="company_id"/>
                        <field name="flow_type_id"/>
                        <field name="account_id"/>
                        <field name="note"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_cash_planning_account_line_search" model="ir.ui.view">
        <field name="name">cash.planning.account.line.search</field>
        <field name="model">cash.planning.account.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="flow_type_id"/>
                <field name="account_id"/>
                <field name="company_id"/>
                <filter name="active" string="Active" domain="[('active','=',True)]"/>
                <!-- <group expand="0" string="Group By">
                    <filter name="group_company" string="Company" context="{'group_by':'company_id'}"/>
                    <filter name="group_type" string="Cash Flow Type" context="{'group_by':'flow_type_id'}"/>
                </group> -->
            </search>
        </field>
    </record>
    <record id="action_cash_planning_account_line" model="ir.actions.act_window">
        <field name="name">Cash Flow Accounts</field>
        <field name="res_model">cash.planning.account.line</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
