<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cash_planning_flow_rule_list" model="ir.ui.view">
        <field name="name">cash.planning.flow.rule.list</field>
        <field name="model">cash.planning.flow.rule</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="company_id"/>
                <field name="flow_type_id"/>
                <field name="match_type"/>
                <field name="account_code"/>
                <field name="account_type"/>
                <field name="auto_create_mapping"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="view_cash_planning_flow_rule_form" model="ir.ui.view">
        <field name="name">cash.planning.flow.rule.form</field>
        <field name="model">cash.planning.flow.rule</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="sequence"/>
                            <field name="company_id"/>
                            <field name="flow_type_id"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="match_type"/>
                            <field name="account_code"/>
                            <field name="account_type"/>
                            <field name="auto_create_mapping"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_cash_planning_flow_rule_search" model="ir.ui.view">
        <field name="name">cash.planning.flow.rule.search</field>
        <field name="model">cash.planning.flow.rule</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="flow_type_id"/>
                <field name="account_code"/>
                <field name="company_id"/>
                <!-- <group expand="0" string="Group By">
                    <filter name="group_type" string="Cash Flow Type" context="{'group_by':'flow_type_id'}"/>
                    <filter name="group_match_type" string="Match Type" context="{'group_by':'match_type'}"/>
                </group> -->
            </search>
        </field>
    </record>
    <record id="action_cash_planning_flow_rule" model="ir.actions.act_window">
        <field name="name">Cash Flow Rules</field>
        <field name="res_model">cash.planning.flow.rule</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
