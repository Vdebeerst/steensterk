<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="ziggu_project_project_form" model="ir.ui.view">
            <field name="name">ziggu.res.partner.form</field>
            <field name="model">project.project</field>
            <field name="inherit_id" ref="project.edit_project"/>
            <field name="arch" type="xml">
                <xpath expr="//header" position="inside">
                    <button name="action_fill_ziggu_decisions" type="object" string="Vul decisions" invisible="date_start == False"/>
                    <button name="action_push_ziggu_decisions" type="object" string="Update Ziggu" invisible="True"/>
                </xpath>
                <notebook position="inside">
                    <page string="Ziggu" name="ziggu">
                        <group colspan="4" col="2">
                            <group string="Id/Address">
                                <field name="ziggu_id" readonly="True"/>
                                <field name="ziggu_address_street" readonly="True"/>
                                <field name="ziggu_address_number" readonly="True"/>
                                <field name="ziggu_address_zip" readonly="True"/>
                                <field name="ziggu_address_city" readonly="True"/>
                                <field name="ziggu_country_id" readonly="True"/>
                                <field name="ziggu_currency_id" readonly="True"/>
                            </group>
                            <group string="Dates">
                                <field name="ziggu_start_date" readonly="True"/>
                                <field name="ziggu_delivery_date_actual" readonly="True"/>
                                <field name="ziggu_delivery_date_contractual" readonly="True"/>
                                <field name="ziggu_timezone" readonly="True"/>
                                <field name="ziggu_created_at" readonly="True"/>
                                <field name="ziggu_updated_at" readonly="True"/>
                            </group>
                        </group>
                        <group colspan="4" col="2">
                            <group string="Project Information">
                                <field name="ziggu_is_template" readonly="True"/>
                                <field name="ziggu_measurement" readonly="True"/>
                                <field name="ziggu_quotity_total" readonly="True"/>
                                <field name="ziggu_skip_building" readonly="True"/>
                                <field name="ziggu_skip_lot" readonly="True"/>
                                <field name="ziggu_skip_phase" readonly="True"/>
                                <field name="ziggu_units_active_count" readonly="True"/>
                                <field name="ziggu_units_count_max" readonly="True"/>
                                <field name="ziggu_vat_percentage" readonly="True"/>
                                <field name="ziggu_status" readonly="True"/>
                            </group>
                            <group string="Url's">
                                <field name="ziggu_picture_login_url" readonly="True" widget="url"/>
                                <field name="ziggu_website_url" readonly="True" widget="url"/>
                            </group>
                        </group>
                        <field name="ziggu_description" readonly="True"/>
                    </page>
                    <page string="Buildings" name="buildings">
                        <field name="ziggu_building_ids" readonly="True"/>
                    </page>
                    <page string="Units" name="units">
                        <field name="ziggu_unit_ids" readonly="True"/>
                    </page>
                    <!-- <page string="Lots" name="lots">
                        <field name="ziggu_lot_ids" readonly="True"/>
                    </page> -->
                    <page string="Decision Types" name="decision_types">
                        <field name="ziggu_decision_type_ids" readonly="True"/>
                    </page>
                    <page string="Decisions" name="decisions">
                        <field name="ziggu_decision_ids">
                            <list string="Decision" editable="bottom">
                                <field name="ziggu_decision_type_id" domain="[('ziggu_project_id', '=', ziggu_project_id)]"/>
                                <field name="ziggu_project_id" column_invisible="True"/>
                                <field name="ziggu_employee_id"/>
                                <field name="ziggu_due_date"/>
                                <field name="ziggu_approved_at"/>
                                <field name="ziggu_unit_id" optional="hide"/>
                                <field name="ziggu_published_customer"/>
                                <field name="ziggu_published_partners"/>
                                <field name="active"/>
                            </list>
                            <form string="Decision">
                                <group>
                                    <group>
                                        <field name="ziggu_decision_type_id" domain="[('ziggu_project_id', '=', ziggu_project_id)]"/>
                                        <field name="ziggu_project_id" invisible="True"/>
                                        <field name="ziggu_employee_id"/>
                                        <field name="ziggu_unit_id"/>
                                    </group>
                                    <group>
                                        <field name="ziggu_due_date"/>
                                        <field name="ziggu_approved_at"/>
                                        <field name="ziggu_published_customer"/>
                                        <field name="ziggu_published_partners"/>
                                        <field name="active"/>
                                    </group>
                                </group>
                            </form>
                        </field>
                    </page>
                </notebook>
            </field>
        </record>

    </data>
</odoo>
